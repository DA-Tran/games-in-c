# build artefacts
*.o
*.exe
.venv/

# The compiled binary, anchored to the repo root. A bare "games" would match
# any path component of that name and silently exclude src/games/ and
# web/js/games/ — which is exactly what happened for the first three commits.
/games

# The sanitised build, same anchoring rule. It is 12MB and regenerated by
# "make asan", so it has no business in history.
/games-asan

# runtime state
.gic_scores
